Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Expose only files stored on the public disk; do not expose storage internals.
    RewriteCond /home/dscx7887/public_html/malang-web.site/pilotfb/storage/app/public/$1 -f
    RewriteRule ^storage/(.+)$ storage/app/public/$1 [END]

    # Never expose Laravel source, manifests, or deployment credentials.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:artisan|composer\.json|composer\.lock|package(?:-lock)?\.json|vite\.config\.js|postcss\.config\.js|tailwind\.config\.js|phpunit\.xml|\.cpanel\.yml|\.gitignore|README\.md|\.env(?:\..*)?|\.git)(?:/|$) - [F,L,NC]

    # Serve existing public files such as /pilotfb/build/* and favicon assets.
    RewriteCond /home/dscx7887/public_html/malang-web.site/pilotfb/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # Keep the direct /public URL working while the preferred URL uses root index.php.
    RewriteRule ^public(?:/|$) - [L]

    # Send /pilotfb, /pilotfb/login, /pilotfb/dashboard, and /pilotfb/settings
    # to the subdirectory-aware Laravel front controller.
    RewriteRule ^ index.php [L]
</IfModule>